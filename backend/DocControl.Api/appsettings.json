{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=DocVersionControlDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "BackupSettings": {
    "Enabled": true,
    "IntervalHours": 24,
    "RetentionCount": 10,
    "FolderName": "Backups"
  },
  "AllowedHosts": "*"
}